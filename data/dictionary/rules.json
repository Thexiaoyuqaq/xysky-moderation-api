{
  "rules": [
    {
      "id": "privacy.phone",
      "category": "privacy",
      "pattern": "(?<![0-9])1[3-9][0-9]{9}(?![0-9])",
      "description": "手机号"
    },
    {
      "id": "privacy.phone_separated",
      "category": "privacy",
      "pattern": "(?<![0-9])1[3-9][0-9][ -]?[0-9]{4}[ -]?[0-9]{4}(?![0-9])",
      "description": "带分隔符的手机号"
    },
    {
      "id": "privacy.idcard",
      "category": "privacy",
      "severity": 4,
      "pattern": "(?<![0-9])[1-9][0-9]{5}(?:19|20)[0-9]{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])[0-9]{3}[0-9x](?![0-9a-z])",
      "description": "身份证号"
    },
    {
      "id": "privacy.bankcard",
      "category": "privacy",
      "severity": 4,
      "pattern": "(?:银行卡|卡号)[^0-9\\n]{0,4}[0-9]{16,19}",
      "description": "银行卡号"
    },
    {
      "id": "privacy.email",
      "category": "privacy",
      "pattern": "[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}",
      "description": "邮箱地址"
    },
    {
      "id": "privacy.url",
      "category": "privacy",
      "pattern": "(?:https?://|www\\.)[a-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]{3,}",
      "description": "URL"
    },
    {
      "id": "privacy.qq",
      "category": "privacy",
      "pattern": "(?:qq|扣扣|企鹅)[^0-9\\n]{0,4}[0-9]{5,11}",
      "description": "QQ 号"
    },
    {
      "id": "privacy.wechat",
      "category": "privacy",
      "pattern": "(?:vx|wx|v信|威信|微信|wechat)[^a-z0-9\\n]{0,4}[a-z][a-z0-9_-]{4,19}",
      "description": "微信号"
    },
    {
      "id": "privacy.long_digits",
      "category": "privacy",
      "severity": 1,
      "action": "review",
      "pattern": "(?<![0-9])(?!([0-9])\\1{7,})[0-9]{8,}(?![0-9])",
      "description": "长数字串"
    },
    {
      "id": "advertisement.contact",
      "category": "advertisement",
      "pattern": "(?:加|搜|私|dd|滴|联系|关注)[^。！？\\n]{0,6}(?:微信|vx|wx|v信|威信|qq|q群|群|公众号|抖音|快手|小红书)",
      "description": "引导私下联系"
    },
    {
      "id": "advertisement.other_app",
      "category": "advertisement",
      "severity": 3,
      "pattern": "(?:加|下|装|用|换|去)[^。！？\\n]{0,4}(?:钉钉|飞书|陌陌|探探|soul|积目|伊对|连信|他趣)",
      "description": "引导使用其他社交软件"
    },
    {
      "id": "advertisement.invite",
      "category": "advertisement",
      "pattern": "(?:discord\\.gg|t\\.me|telegram|电报|纸飞机|进群|加群|入群)",
      "description": "外站/群聊邀请"
    },
    {
      "id": "advertisement.scan",
      "category": "advertisement",
      "pattern": "(?:扫码|扫一扫|二维码|长按复制|复制口令|淘口令)",
      "description": "扫码/口令引流"
    },
    {
      "id": "advertisement.sale",
      "category": "advertisement",
      "pattern": "(?:低价|便宜|打折|优惠)[^。！？\\n]{0,4}(?:出售|卖|代购|代充|代练)",
      "description": "低价促销广告"
    },
    {
      "id": "advertisement.short_link",
      "category": "advertisement",
      "pattern": "(?:bit\\.ly|tinyurl\\.com|t\\.cn|url\\.cn|dwz\\.cn|suo\\.im)/[a-z0-9]{2,}",
      "description": "短链接"
    },
    {
      "id": "advertisement.guangyu_trade",
      "category": "advertisement",
      "severity": 2,
      "action": "review",
      "pattern": "(?:出|收|卖|求)[^。！？\\n]{0,2}(?:蜡烛|爱心|季卡|月卡|毕业号|账号|小号)",
      "description": "光遇资源交易黑话"
    },
    {
      "id": "fraud.income",
      "category": "fraud",
      "pattern": "(?:日赚|日入|月入|稳赚|躺赚|带你赚钱|包回本)[^。！？\\n]{0,8}(?:[0-9]+|[元块万])",
      "description": "收益承诺"
    },
    {
      "id": "fraud.invest",
      "category": "fraud",
      "pattern": "(?:投资|理财|炒股|带单|荐股)[^。！？\\n]{0,6}(?:稳赚|包赚|高回报|老师|群)",
      "description": "投资带单诈骗"
    },
    {
      "id": "fraud.refund",
      "category": "fraud",
      "pattern": "(?:游戏)?(?:充值)?退款[^。！？\\n]{0,6}(?:代退|包退|收费|联系|客服)",
      "description": "代退款诈骗"
    },
    {
      "id": "fraud.gambling_site",
      "category": "fraud",
      "pattern": "(?:bet365|1xbet|新葡京|太阳城|金沙娱乐|皇冠体育)",
      "description": "境外赌博站点"
    },
    {
      "id": "fraud.phishing",
      "category": "fraud",
      "severity": 4,
      "pattern": "(?:点击|打开|访问)[^。！？\\n]{0,6}(?:领取|激活|认证|验证)[^。！？\\n]{0,6}(?:链接|网址|地址)",
      "description": "钓鱼链接诱导"
    },
    {
      "id": "minor.solicit",
      "category": "minor_safety",
      "pattern": "(?:未成年|学生妹|萝莉)[^。！？\\n]{0,8}(?:约|裸|色|性|视频|开房|包养)",
      "description": "涉及未成年人的性诱导"
    },
    {
      "id": "minor.secrecy",
      "category": "minor_safety",
      "severity": 4,
      "pattern": "(?:别|不要|不能|不许)(?:告诉|跟|和)[^。！？\\n]{0,4}(?:爸|妈|父母|家长|老师|家人)",
      "description": "要求对监护人保密"
    },
    {
      "id": "minor.age_probe",
      "category": "minor_safety",
      "severity": 3,
      "pattern": "(?:多大了|几岁了)[^。！？\\n]{0,8}(?:约|裸|照片|视频|见面|开房|交往)",
      "description": "打探年龄并引向性/约见"
    },
    {
      "id": "minor.gift_bait",
      "category": "minor_safety",
      "severity": 4,
      "pattern": "(?:送你|给你|帮你)[^。！？\\n]{0,4}(?:皮肤|季卡|月卡|蜡烛|爱心|礼物|红包)[^。！？\\n]{0,10}(?:脱|照片|视频|见面|加微信|私聊|听话)",
      "description": "礼物换取条件"
    },
    {
      "id": "selfharm.method",
      "category": "selfharm",
      "pattern": "(?:怎么|如何|方法|教程|想)[^。！？\\n]{0,4}(?:自杀|割腕|上吊|烧炭|跳楼)",
      "description": "自残方式询问"
    },
    {
      "id": "sexual.solicit_media",
      "category": "sexual",
      "severity": 4,
      "pattern": "(?:发|给|拍|录)[^。！？\\n]{0,4}(?:裸|私密|色情)[^。！？\\n]{0,3}(?:照|视频|图)",
      "description": "索取色情影像"
    },
    {
      "id": "sexual.body_comment",
      "category": "sexual",
      "severity": 3,
      "pattern": "(?:看看|给我看|让我看)[^。！？\\n]{0,3}(?:腿|胸|脚|屁股|身材)",
      "description": "索取身体部位照片"
    },
    {
      "id": "violence.threat_meet",
      "category": "violence",
      "severity": 4,
      "pattern": "(?:现实|线下|真人)[^。！？\\n]{0,4}(?:找你|堵你|打你|揍你|收拾你)",
      "description": "线下威胁"
    },
    {
      "id": "violence.doxx",
      "category": "violence",
      "severity": 4,
      "pattern": "(?:人肉|开盒|查你|扒你)[^。！？\\n]{0,4}(?:地址|信息|家人|学校|电话)",
      "description": "人肉开盒威胁"
    },
    {
      "id": "evasion.invisible",
      "category": "evasion",
      "view": "raw",
      "pattern": "[\\u00AD\\u200B-\\u200F\\u2060-\\u2064\\uFEFF]{2,}",
      "description": "批量不可见字符"
    },
    {
      "id": "evasion.zalgo",
      "category": "evasion",
      "view": "raw",
      "pattern": "[\\u0300-\\u036F]{8,}",
      "description": "组合符堆叠"
    },
    {
      "id": "evasion.pinyin",
      "category": "evasion",
      "severity": 2,
      "action": "review",
      "pattern": "(?:nmsl|wcnm|cnmb|wdnmd|tmd|mmp)",
      "description": "拼音缩写规避"
    },
    {
      "id": "politics.circumvent",
      "category": "politics",
      "severity": 1,
      "action": "review",
      "pattern": "(?:翻墙|科学上网|v2ray|clash|shadowsocks)",
      "description": "网络规避工具"
    }
  ]
}
